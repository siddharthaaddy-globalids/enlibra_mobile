# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Signing material. Committing any of these is unrecoverable: an Android
# upload keystore cannot be replaced once the app is on Play.
android/key.properties
android/upload-keystore.jks
*.jks
*.keystore
*.p12
*.mobileprovision
ios/ExportOptions.plist

# Downloaded model weights, if any end up under the project during dev.
*.gguf

# Native build output. The Apple xcframework is ~200MB and is rebuilt by
# packages/llama_bridge/tool/build_apple_frameworks.sh; CI caches it by
# llama.cpp submodule SHA rather than committing it.
packages/llama_bridge/*/Frameworks/
*.xcframework
build/native/
.ccache/
